[node name="Examinar" type="Area3D" parent="Miskatonic/Dias/Fotografias/Foto4" unique_id=951828944]
script = ExtResource("69_1yx2f")
title = "Fotografia — a pedra negra"
description = "A grande pedra negra de Round Hill, sobre a mesa do escritório de Akeley: fileiras de livros e um busto de Milton ao fundo. Que princípios geométricos guiaram o corte dela, eu não saberia dizer."
initial_rotation = Vector3(90, 0, 0)
prompt = "Examinar a fotografia"

[node name="CollisionShape3D" type="CollisionShape3D" parent="Miskatonic/Dias/Fotografias/Foto4/Examinar" unique_id=324636394]
