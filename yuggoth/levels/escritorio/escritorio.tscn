title = "Fotografia — a caverna"
description = "Uma exposição longa, em sombra funda: a boca de uma caverna na mata, entupida por um matacão de uma regularidade arredondada."
initial_rotation = Vector3(90, 0, 0)
prompt = "Examinar a fotografia"

