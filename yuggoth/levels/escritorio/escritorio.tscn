[node name="Examinar" type="Area3D" parent="Miskatonic/Fotografias/Foto4" unique_id=1640762809]
script = ExtResource("48_4ueoc")
title = "Fotografia — a pedra negra"
description = "A grande pedra negra de Round Hill, sobre a mesa do escritório de Akeley: fileiras de livros e um busto de Milton ao fundo. Que princípios geométricos guiaram o corte dela, eu não saberia dizer."
