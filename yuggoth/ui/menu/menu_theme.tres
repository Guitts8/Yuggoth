[gd_resource type="Theme" load_steps=5 format=3]

[sub_resource type="SystemFont" id="SystemFont_serif"]
font_names = PackedStringArray("Georgia", "Times New Roman", "serif")

[sub_resource type="StyleBoxEmpty" id="StyleBoxEmpty_button"]
content_margin_left = 16.0
content_margin_top = 6.0
content_margin_right = 16.0
content_margin_bottom = 6.0

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_focus"]
content_margin_left = 16.0
content_margin_top = 6.0
content_margin_right = 16.0
content_margin_bottom = 6.0
bg_color = Color(0.9, 0.84, 0.72, 0.07)
border_width_left = 3
border_color = Color(0.72, 0.58, 0.36, 1)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
content_margin_left = 48.0
content_margin_top = 40.0
content_margin_right = 48.0
content_margin_bottom = 40.0
bg_color = Color(0.11, 0.09, 0.07, 0.96)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.45, 0.37, 0.27, 1)

[resource]
default_font = SubResource("SystemFont_serif")
default_font_size = 28
Button/colors/font_color = Color(0.72, 0.66, 0.56, 1)
Button/colors/font_disabled_color = Color(0.38, 0.35, 0.31, 1)
Button/colors/font_focus_color = Color(0.98, 0.93, 0.82, 1)
Button/colors/font_hover_color = Color(0.98, 0.93, 0.82, 1)
Button/colors/font_hover_pressed_color = Color(1, 1, 1, 1)
Button/colors/font_pressed_color = Color(1, 1, 1, 1)
Button/styles/disabled = SubResource("StyleBoxEmpty_button")
Button/styles/focus = SubResource("StyleBoxFlat_focus")
Button/styles/hover = SubResource("StyleBoxEmpty_button")
Button/styles/normal = SubResource("StyleBoxEmpty_button")
Button/styles/pressed = SubResource("StyleBoxFlat_focus")
Label/colors/font_color = Color(0.9, 0.84, 0.72, 1)
PanelContainer/styles/panel = SubResource("StyleBoxFlat_panel")
