[gd_resource type="Resource" script_class="NarrationLine" load_steps=2 format=3]

[ext_resource type="Script" path="res://narrative/narration_line.gd" id="1_line"]

[resource]
script = ExtResource("1_line")
id = &"cartao_boston"
text = "Naquela noite fui a Boston falar com o funcionário: um rapaz franco e simpático, que nada pôde acrescentar. Mal tinha certeza de que reconheceria o estranho de novo."
