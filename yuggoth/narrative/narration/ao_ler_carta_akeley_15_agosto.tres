[ext_resource type="Script" path="res://narrative/narration_line.gd" id="1_line"]

[resource]
script = ExtResource("1_line")
id = &"ao_ler_carta_akeley_15_agosto"
text = "Minha atitude diante do caso passava depressa do científico para um alarme pessoal. Eu temia por Akeley, na sua fazenda remota e solitária — e meio temia por mim mesmo."
