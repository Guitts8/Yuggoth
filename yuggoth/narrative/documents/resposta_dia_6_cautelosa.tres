[resource]
script = ExtResource("1_doc")
id = &"resposta_dia_6_cautelosa"
title = "Minha carta a Akeley — 7 de setembro (registrada)"
style = 0
pages = PackedStringArray("[right]Rua Saltonstall, 118
Arkham, Massachusetts
7 de setembro de 1928[/right]

Prezado Akeley,

Mude-se para Brattleboro imediatamente — hoje, se puder — e ponha-se sob a proteção das autoridades. Não fique mais uma noite nessa casa. Deixe os livros, deixe tudo; as coisas se buscam depois.

Se o xerife não lhe der ouvidos, procure um advogado. Guarde o que tiver de provas, mas não arrisque a vida por elas.

Escreverei ao seu filho se não tiver notícias suas. Responda-me.

[right]A. N. W.[/right]")
exposure_on_read = 0.0
