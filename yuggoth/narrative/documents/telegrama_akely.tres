[gd_resource type="Resource" script_class="DocumentData" load_steps=2 format=3]

[ext_resource type="Script" path="res://narrative/document_data.gd" id="1_doc"]

[resource]
script = ExtResource("1_doc")
id = &"telegrama_akely"
title = "Telegrama de Bellows Falls — agosto"
style = 3
pages = PackedStringArray("WESTERN UNION
BELLOWS FALLS VT 17 AGO 1928

PROF A N WILMARTH
118 SALTONSTALL ST ARKHAM MASS

COMPREENDO SUA POSICAO MAS NADA POSSO FAZER. NAO TOME NENHUMA PROVIDENCIA PORQUE ISSO SO PODERIA PREJUDICAR A AMBOS. AGUARDE EXPLICACAO.

HENRY AKELY")
exposure_on_read = 0.0
