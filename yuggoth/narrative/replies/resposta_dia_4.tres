[gd_resource type="Resource" script_class="ReplyData" load_steps=10 format=3]

[ext_resource type="Script" path="res://narrative/reply_data.gd" id="1_reply"]
[ext_resource type="Script" path="res://narrative/reply_option.gd" id="2_option"]
[ext_resource type="Resource" path="res://narrative/documents/resposta_dia_4_cetica.tres" id="3_cetica"]
[ext_resource type="Resource" path="res://narrative/documents/resposta_dia_4_cautelosa.tres" id="4_cautelosa"]
[ext_resource type="Resource" path="res://narrative/documents/resposta_dia_4_credula.tres" id="5_credula"]
[ext_resource type="Resource" path="res://narrative/narration/investigacoes_nada.tres" id="6_nada"]

[sub_resource type="Resource" id="Resource_cetica"]
script = ExtResource("2_option")
tom = -1
resumo = "Caixas pesadas se extraviam todos os dias."
document = ExtResource("3_cetica")

[sub_resource type="Resource" id="Resource_cautelosa"]
script = ExtResource("2_option")
tom = 0
resumo = "Esse homem de voz estranha há de ter um lugar central neste negócio."
document = ExtResource("4_cautelosa")

[sub_resource type="Resource" id="Resource_credula"]
script = ExtResource("2_option")
tom = 1
resumo = "A pedra não chegou, e o senhor já sabe por quê."
document = ExtResource("5_credula")

[resource]
script = ExtResource("1_reply")
id = &"resposta_dia_4"
destinatario = "A Akeley — e à companhia, à polícia, a Keene"
options = Array[ExtResource("2_option")]([SubResource("Resource_cetica"), SubResource("Resource_cautelosa"), SubResource("Resource_credula")])
narracao_depois = ExtResource("6_nada")
