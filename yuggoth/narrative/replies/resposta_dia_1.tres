[gd_resource type="Resource" script_class="ReplyData" load_steps=9 format=3]

[ext_resource type="Script" path="res://narrative/reply_data.gd" id="1_reply"]
[ext_resource type="Script" path="res://narrative/reply_option.gd" id="2_option"]
[ext_resource type="Resource" path="res://narrative/documents/resposta_dia_1_cetica.tres" id="3_cetica"]
[ext_resource type="Resource" path="res://narrative/documents/resposta_dia_1_cautelosa.tres" id="4_cautelosa"]
[ext_resource type="Resource" path="res://narrative/documents/resposta_dia_1_credula.tres" id="5_credula"]

[sub_resource type="Resource" id="Resource_cetica"]
script = ExtResource("2_option")
tom = -1
resumo = "Pegadas na lama e vozes à noite admitem explicações mais simples."
document = ExtResource("3_cetica")

[sub_resource type="Resource" id="Resource_cautelosa"]
script = ExtResource("2_option")
tom = 0
resumo = "Não o tomo por louco, mas preciso ver antes de crer."
document = ExtResource("4_cautelosa")

[sub_resource type="Resource" id="Resource_credula"]
script = ExtResource("2_option")
tom = 1
resumo = "Acredito no senhor. Conte-me tudo."
document = ExtResource("5_credula")

[resource]
script = ExtResource("1_reply")
id = &"resposta_dia_1"
options = Array[ExtResource("2_option")]([SubResource("Resource_cetica"), SubResource("Resource_cautelosa"), SubResource("Resource_credula")])
