[gd_resource type="Resource" script_class="ReplyData" load_steps=10 format=3]

[ext_resource type="Script" path="res://narrative/reply_data.gd" id="1_reply"]
[ext_resource type="Script" path="res://narrative/reply_option.gd" id="2_option"]
[ext_resource type="Resource" path="res://narrative/documents/resposta_dia_6_cetica.tres" id="3_cetica"]
[ext_resource type="Resource" path="res://narrative/documents/resposta_dia_6_cautelosa.tres" id="4_cautelosa"]
[ext_resource type="Resource" path="res://narrative/documents/resposta_dia_6_credula.tres" id="5_credula"]
[ext_resource type="Resource" path="res://narrative/narration/resposta_registrada.tres" id="6_narr"]

[sub_resource type="Resource" id="Resource_cetica"]
script = ExtResource("2_option")
tom = -1
resumo = "Vá para Brattleboro e procure um médico. O senhor está exausto."
document = ExtResource("3_cetica")

[sub_resource type="Resource" id="Resource_cautelosa"]
script = ExtResource("2_option")
tom = 0
resumo = "Mude-se para Brattleboro hoje, e deixe tudo para trás."
document = ExtResource("4_cautelosa")

[sub_resource type="Resource" id="Resource_credula"]
script = ExtResource("2_option")
tom = 1
resumo = "Mude-se para Brattleboro. Eu levo o disco e convenço os tribunais."
document = ExtResource("5_credula")

[resource]
script = ExtResource("1_reply")
id = &"resposta_dia_6"
destinatario = "Ao Sr. Henry W. Akeley — registrada"
options = Array[ExtResource("2_option")]([SubResource("Resource_cetica"), SubResource("Resource_cautelosa"), SubResource("Resource_credula")])
narracao_depois = ExtResource("6_narr")
