[gd_resource type="Resource" script_class="ReplyData" load_steps=10 format=3]

[ext_resource type="Script" path="res://narrative/reply_data.gd" id="1_reply"]
[ext_resource type="Script" path="res://narrative/reply_option.gd" id="2_option"]
[ext_resource type="Resource" path="res://narrative/documents/resposta_dia_5_cetica.tres" id="3_cetica"]
[ext_resource type="Resource" path="res://narrative/documents/resposta_dia_5_cautelosa.tres" id="4_cautelosa"]
[ext_resource type="Resource" path="res://narrative/documents/resposta_dia_5_credula.tres" id="5_credula"]
[ext_resource type="Resource" path="res://narrative/narration/resposta_animadora.tres" id="6_narr"]

[sub_resource type="Resource" id="Resource_cetica"]
script = ExtResource("2_option")
tom = -1
resumo = "Vá à polícia. Homens de carne e osso cortam fios e mandam telegramas."
document = ExtResource("3_cetica")

[sub_resource type="Resource" id="Resource_cautelosa"]
script = ExtResource("2_option")
tom = 0
resumo = "Uma saída digna é perfeitamente possível, e conte comigo para ela."
document = ExtResource("4_cautelosa")

[sub_resource type="Resource" id="Resource_credula"]
script = ExtResource("2_option")
tom = 1
resumo = "Não espere pôr as coisas em ordem."
document = ExtResource("5_credula")

[resource]
script = ExtResource("1_reply")
id = &"resposta_dia_5"
endereco = "Henry W. Akeley, Esq.\nGeneral Delivery\nBrattleboro, Vt."
options = Array[ExtResource("2_option")]([SubResource("Resource_cetica"), SubResource("Resource_cautelosa"), SubResource("Resource_credula")])
narracao_depois = ExtResource("6_narr")
