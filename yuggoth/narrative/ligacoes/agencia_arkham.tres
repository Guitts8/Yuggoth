[gd_resource type="Resource" script_class="Ligacao" load_steps=5 format=3]

[ext_resource type="Script" path="res://narrative/ligacao.gd" id="1_lig"]
[ext_resource type="Script" path="res://narrative/conditions/value_condition.gd" id="2_cond"]
[ext_resource type="Resource" path="res://narrative/narration/depois_agencia.tres" id="3_narr"]

[sub_resource type="Resource" id="Resource_cond"]
script = ExtResource("2_cond")
key = &"leu_telegrama_pedra"
op = 3
value = 1.0

[resource]
script = ExtResource("1_lig")
id = &"agencia_arkham"
prompt = "Telefonar à agência do expresso"
condition = SubResource("Resource_cond")
recebida = false
falas = PackedStringArray("Telefonista: Número, por favor.", "Wilmarth: A agência do expresso, por favor.", "Agência: Expresso, Arkham.", "Wilmarth: Aqui é o professor Wilmarth, da Rua Saltonstall. Espero uma caixa pesada, despachada ontem de Bellows Falls.", "Agência: Nenhuma remessa para o senhor, professor. Não chegou nada.")
narracao_depois = ExtResource("3_narr")
