[gd_resource type="Resource" script_class="Ligacao" load_steps=4 format=3]

[ext_resource type="Script" path="res://narrative/ligacao.gd" id="1_lig"]
[ext_resource type="Script" path="res://narrative/conditions/value_condition.gd" id="2_cond"]

[sub_resource type="Resource" id="Resource_cond"]
script = ExtResource("2_cond")
key = &"ligou_boston_homem"
op = 3
value = 1.0

[resource]
script = ExtResource("1_lig")
id = &"boston_voz"
prompt = "Perguntar pela voz dele"
condition = SubResource("Resource_cond")
falas = PackedStringArray("Wilmarth: E a voz dele?", "Funcionário: A voz... era grossa. Uma voz curiosa, zumbida — não sei dizer de outro jeito.", "Funcionário: Me deixava tonto e com sono, só de ouvir.", "Funcionário: Não me lembro bem de como a conversa terminou. Só de acordar de vez quando o trem começou a andar.")
sonho = 0.45
