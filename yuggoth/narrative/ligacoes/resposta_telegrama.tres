[gd_resource type="Resource" script_class="Ligacao" load_steps=5 format=3]

[ext_resource type="Script" path="res://narrative/ligacao.gd" id="1_lig"]
[ext_resource type="Script" path="res://narrative/conditions/value_condition.gd" id="2_cond"]
[ext_resource type="Resource" path="res://narrative/narration/cartao_aprofundava.tres" id="3_cart"]

[sub_resource type="Resource" id="Resource_cond"]
script = ExtResource("2_cond")
key = &"leu_telegrama_akely"
op = 3
value = 1.0

[resource]
script = ExtResource("1_lig")
id = &"resposta_telegrama"
prompt = "Telegrafar a resposta a Akeley"
condition = SubResource("Resource_cond")
recebida = false
falas = PackedStringArray("Telefonista: Western Union.", "Wilmarth: Um telegrama, por favor. Para Henry W. Akeley, Posta-Restante, Brattleboro, Vermont.", "Wilmarth: RECEBI SEU TELEGRAMA. NAO COMPREENDO. AGUARDO EXPLICACAO. ESCREVA LOGO. WILMARTH.")
cartao_depois = ExtResource("3_cart")
